<ContentPage
    BackgroundColor="Wheat"
    Title="Review and Pay"
    x:Class="BubbleAppNew.OrderConfirmationPage.OrderPage"
    x:DataType="orderConfirmationPage:OrderConfirmationViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:models="clr-namespace:BubbleLib.Models"
    xmlns:orderConfirmationPage="clr-namespace:BubbleAppNew.OrderConfirmationPage"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid Padding="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.55*" />
            <ColumnDefinition Width="0.45*" />
        </Grid.ColumnDefinitions>

        <!--  Left Column: Order Summary  -->
        <VerticalStackLayout
            Grid.Column="0"
            Padding="15"
            Spacing="15"
            VerticalOptions="Start">

            <Label
                FontAttributes="Bold"
                FontSize="24"
                HorizontalOptions="Start"
                Text="Bestellung"
                TextColor="Black" />

            <Label
                FontSize="12"
                Text="{Binding OrderId, StringFormat='Order ID: {0}'}"
                TextColor="Gray" />

            <Frame
                BackgroundColor="White"
                BorderColor="#CCCCCC"
                CornerRadius="12"
                HasShadow="True"
                Padding="10">

                <CollectionView HeightRequest="300" ItemsSource="{Binding OrderedItems}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:BubbleWaffle">
                            <Grid ColumnDefinitions="*,Auto" Padding="5,2">
                                <Label
                                    FontSize="18"
                                    Grid.Column="0"
                                    Text="{Binding WaffleName}"
                                    TextColor="Black" />
                                <Label
                                    FontSize="18"
                                    Grid.Column="1"
                                    Text="{Binding WafflePrice, StringFormat='€ {0:F2}'}"
                                    TextColor="DarkGreen" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <Label
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Start"
                Text="{Binding EuroPrice, StringFormat='Gesamtsumme: € {0:F2}'}"
                TextColor="Black" />

            <Label
                FontSize="18"
                HorizontalOptions="Start"
                Text="{Binding SolanaRate, StringFormat='Aktueller Kurs: 1 SOL = €{0:F2}'}"
                TextColor="Gray" />

            <Label
                FontAttributes="Bold"
                FontSize="22"
                HorizontalOptions="Start"
                Text="{Binding TotalSol, StringFormat='Zu bezahlen: {0:F3} SOL'}"
                TextColor="DarkGreen" />
        </VerticalStackLayout>

        <!--  Right Column: QR Code  -->
        <VerticalStackLayout
            Grid.Column="1"
            HorizontalOptions="Center"
            Padding="10"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                FontAttributes="Bold, Italic"
                FontSize="22"
                HorizontalOptions="Center"
                Text="Scannen zum Bezahlen" />

            <Frame
                BackgroundColor="White"
                BorderColor="#888888"
                CornerRadius="10"
                HasShadow="True"
                HeightRequest="520"
                HorizontalOptions="Center"
                Padding="5"
                WidthRequest="520">

                <Image
                    Aspect="AspectFit"
                    BackgroundColor="LightGray"
                    HeightRequest="500"
                    Source="{Binding QrCodeImage}"
                    WidthRequest="500" />
            </Frame>

            <Label
                FontSize="18"
                HorizontalOptions="Center"
                Text="{Binding ShortWalletAddress, StringFormat='Wallet: {0}'}"
                TextColor="Gray" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
